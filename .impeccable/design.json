  "narrative": {
    "northStar": "零一之间的扫描实验室",
    "overview": "界面像一间仍在运行的黑色实验室：透视网格给出方向，白色扫描光标记正在发生的探索，内容悬浮在空间中但始终保持清晰。技术感来自真实空间、精确线条和响应式交互，而不是堆叠装饰。",
    "keyCharacteristics": [
      "黑白为主，蓝紫只用于章节标题与方向标签。",
      "WebGL 透视网格是品牌签名。",
      "动效服务于探索与扫描，并支持减少动态效果偏好。"
    ],
    "rules": [
      { "name": "The Sparse Accent Rule", "body": "蓝紫只能用于章节标题、状态徽章和必要强调。", "section": "colors" },
      { "name": "The Echo Ceiling Rule", "body": "回声文字只用于首屏品牌名和一句核心口号。", "section": "typography" },
      { "name": "The Layered Space Rule", "body": "先用空间、透明度和边界建立深度；只有交互层才能获得阴影。", "section": "elevation" }
    ],
    "dos": [
      "Do 原样保留深空画布、透视扫描网格、回声标题和描边高光按钮。",
      "Do 用真实、早期、可共建的语言表达社团状态。"
    ],
    "donts": [
      "Don't 做成传统培训机构式的销售页面。",
